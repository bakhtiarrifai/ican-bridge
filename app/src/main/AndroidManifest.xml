<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Health Connect: hanya butuh tulis. Tambah READ kalau nanti mau baca balik. -->
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- app iCan, supaya bisa dicek terinstall atau tidak -->
        <package android:name="com.sinocare.ican.health.ce" />
    </queries>

    <application
        android:label="iCan Bridge"
        android:icon="@android:drawable/ic_dialog_info"
        android:theme="@style/Theme.AppCompat.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Rationale screen wajib untuk Health Connect (API 34+) -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".ICanNotificationListener"
            android:exported="true"
            android:label="iCan Bridge"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
